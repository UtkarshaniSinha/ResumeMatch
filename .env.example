# copy this file to .env and put real values (.env is not uploaded to github)

# generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# empty = sqlite on laptop. on server use postgres url like
# postgresql://username:password@host:5432/dbname
DATABASE_URL=

# "production" only on the server
APP_ENV=development

# 1 = show errors while developing (never on the server)
FLASK_DEBUG=1
